@code {
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private List<Wallet> wallets = new();
    private Wallet selectedWallet = new();
    private CreateWalletRequest newWallet = new();
    private CreateWalletRequest editWallet = new();
    private bool isLoading = true;
    private bool isCreating = false;
    private bool isUpdating = false;
    private string alertMessage = string.Empty;
    private string alertType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadWallets();
    }

    private async Task LoadWallets()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            wallets = await WalletService.GetWalletsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao carregar carteiras: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCreateModal()
    {
        newWallet = new CreateWalletRequest();
        showCreateModal = true;
        StateHasChanged();
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
        newWallet = new CreateWalletRequest();
        StateHasChanged();
    }

    private async Task CreateWallet()
    {
        if (isCreating) return;

        isCreating = true;
        StateHasChanged();

        try 
        {
            var result = await WalletService.CreateWalletAsync(newWallet);

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideCreateModal();
                await LoadWallets();
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao criar carteira: {ex.Message}", "error");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private void ShowAlert(string message, string type)
    {
        alertMessage = message;
        alertType = type;
        StateHasChanged();

        // Auto-hide alert after 5 seconds
        Task.Delay(5000).ContinueWith(_ => 
        {
            InvokeAsync(() => 
            {
                ClearAlert();
                StateHasChanged();
            });
        });
    }

    private void ClearAlert()
    {
        alertMessage = string.Empty;
        alertType = string.Empty;
    }
}