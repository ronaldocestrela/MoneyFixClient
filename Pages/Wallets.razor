@page "/wallets"
@using MoneyFixClient.Models
@using MoneyFixClient.Services
@using Microsoft.AspNetCore.Authorization
@inject WalletService WalletService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Carteiras - MoneyFix</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fa-solid fa-wallet text-primary me-2"></i>
                    Gerenciar Carteiras
                </h2>
                @* <button class="btn btn-primary" @onclick="ShowCreateModal"> *@
                <button class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>
                    Nova Carteira
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>
                        Suas Carteiras
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 col-lg-4 mb-3">
                            @* <div class="card border-left-primary h-100"> *@
                            <div class="card h-100"
                                style="border-left: 0.3rem solid #0d6efd">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="card-title text-primary">Carteira 1</h6>
                                            <small class="text-muted">
                                                R$ 1.500,00
                                            </small>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button" id="dropdownMenuButton-1"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-1">
                                                <li>
                                                    <button class="dropdown-item" type="button"
                                                        @* @onclick="() => ShowEditModal(category)" *@
                                                    >
                                                        <i class="fas fa-edit me-2"></i>Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" type="button" disabled>
                                                        <i class="fas fa-trash me-2"></i>Excluir (em breve)
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100"
                                style="border-left: 0.3rem solid #0d9937">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="card-title text-primary">Carteira 2</h6>
                                            <small class="text-muted">
                                                R$ 2.300,00
                                            </small>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button" id="dropdownMenuButton-1"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-1">
                                                <li>
                                                    <button class="dropdown-item" type="button"
                                                        @* @onclick="() => ShowEditModal(category)" *@
                                                    >
                                                        <i class="fas fa-edit me-2"></i>Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" type="button" disabled>
                                                        <i class="fas fa-trash me-2"></i>Excluir (em breve)
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Criar Categoria -->
<div class="modal fade @(showCreateModal ? "show d-block" : "")" tabindex="-1" style="@(showCreateModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus text-primary me-2"></i>
                    Nova Categoria
                </h5>
                <button type="button" class="btn-close" @onclick="HideCreateModal"></button>
            </div>
            <EditForm Model="@newWallet" OnValidSubmit="@CreateWallet">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="walletName" class="form-label">Nome da Carteira</label>
                        <InputText 
                                    @bind-Value="newWallet.Name" 
                                    class="form-control" 
                                    id="walletName" 
                                    placeholder="Ex: Alimentação, Transporte, Lazer..." />
                        <ValidationMessage For="@(() => newWallet.Name)" class="text-danger" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="walletColor" class="form-label">Cor</label>
                        <InputText type="color"
                                    @bind-Value="newWallet.Color"
                                    class="form-control form-control-color"
                                    id="walletColor"
                                    style="width: 3rem; height: 3rem; padding: 0;"
                        />
                        <ValidationMessage For="@(() => newWallet.Color)" class="text-danger" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateModal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Criando...</text>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <text>Criar Categoria</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

