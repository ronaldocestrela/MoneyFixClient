@page "/accounts"
@using System.Globalization
@using MoneyFixClient.Models
@using MoneyFixClient.Services
@using Microsoft.AspNetCore.Authorization
@inject AccountService AccountService
@attribute [Authorize]

<PageTitle>Contas - MoneyFix</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h2 class="mb-0">
                    <i class="fas fa-university text-primary me-2"></i>
                    Gerenciar Contas
                </h2>
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>
                    Nova Conta
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert @(alertType == "success" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    <i class="fas @(alertType == "success" ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                    @alertMessage
                    <button type="button" class="btn-close" @onclick="ClearAlert"></button>
                </div>
            </div>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label class="form-label mb-1" for="filterActive">Filtrar por status</label>
            <select id="filterActive" class="form-select" @bind="listFilterActive" @bind:after="OnListFilterChanged">
                <option value="">Todas</option>
                <option value="true">Ativas</option>
                <option value="false">Inativas</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>
                        Suas Contas
                    </h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <p class="mt-2">Carregando contas...</p>
                        </div>
                    }
                    else if (accounts.Any())
                    {
                        <div class="row">
                            @foreach (var account in accounts)
                            {
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100" style="border-left: 0.3rem solid @GetTypeBorderColor(account.Type);">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="card-title text-primary mb-1">@account.Name</h6>
                                                    <div class="small text-muted mb-1">
                                                        <span class="badge @GetTypeBadgeClass(account.Type)">
                                                            @GetTypeDisplayLabel(account.Type)
                                                        </span>
                                                        @if (account.IsActive)
                                                        {
                                                            <span class="badge bg-success ms-1">Ativa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary ms-1">Inativa</span>
                                                        }
                                                    </div>
                                                    <div class="small mb-1">
                                                        <span class="text-muted">Saldo inicial:</span>
                                                        <strong>@FormatMoney(account.InitialBalance)</strong>
                                                    </div>
                                                    <div class="small mb-1">
                                                        <span class="text-muted">Saldo atual:</span>
                                                        <strong>@FormatMoney(account.CurrentBalance)</strong>
                                                    </div>
                                                    @if (account.CreatedAtUtc.HasValue)
                                                    {
                                                        <small class="text-muted">
                                                            Criada em @account.CreatedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("pt-BR"))
                                                        </small>
                                                    }
                                                </div>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            id="dropdownAccount-@account.Id"
                                                            data-bs-toggle="dropdown"
                                                            aria-expanded="false">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu" aria-labelledby="dropdownAccount-@account.Id">
                                                        <li>
                                                            <button class="dropdown-item" type="button" @onclick="() => ShowEditModal(account)">
                                                                <i class="fas fa-edit me-2"></i>Editar
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button class="dropdown-item text-danger" type="button" @onclick="() => ShowDeleteModal(account)">
                                                                <i class="fas fa-trash me-2"></i>Excluir
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-university fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma conta encontrada</h5>
                            <p class="text-muted">Crie sua primeira conta para vincular transações.</p>
                            <button class="btn btn-primary" @onclick="ShowCreateModal">
                                <i class="fas fa-plus me-2"></i>
                                Criar Primeira Conta
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Criar Conta -->
<div class="modal fade @(showCreateModal ? "show d-block" : "")" tabindex="-1" style="@(showCreateModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus text-primary me-2"></i>
                    Nova Conta
                </h5>
                <button type="button" class="btn-close" @onclick="HideCreateModal"></button>
            </div>
            <EditForm Model="@newAccount" OnValidSubmit="@CreateAccount">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="accountName" class="form-label">Nome</label>
                        <InputText @bind-Value="newAccount.Name" class="form-control" id="accountName" placeholder="Ex.: Conta principal" />
                        <ValidationMessage For="@(() => newAccount.Name)" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="accountType" class="form-label">Tipo</label>
                        <InputSelect @bind-Value="newAccount.Type" class="form-select" id="accountType">
                            <option value="@AccountType.ContaCorrente">Conta corrente</option>
                            <option value="@AccountType.Poupanca">Poupança</option>
                            <option value="@AccountType.Carteira">Carteira</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newAccount.Type)" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="initialBalance" class="form-label">Saldo inicial</label>
                        <InputNumber @bind-Value="newAccount.InitialBalance" class="form-control" id="initialBalance" />
                        <ValidationMessage For="@(() => newAccount.InitialBalance)" class="text-danger" />
                    </div>
                    <div class="mb-3 form-check">
                        <InputCheckbox @bind-Value="newAccount.IsActive" class="form-check-input" id="accountActive" />
                        <label class="form-check-label" for="accountActive">Conta ativa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateModal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Criando...</text>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <text>Criar Conta</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Modal Editar Conta -->
<div class="modal fade @(showEditModal ? "show d-block" : "")" tabindex="-1" style="@(showEditModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit text-primary me-2"></i>
                    Editar Conta
                </h5>
                <button type="button" class="btn-close" @onclick="HideEditModal"></button>
            </div>
            <EditForm Model="@editAccount" OnValidSubmit="@UpdateAccount">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Tipo (não editável)</label>
                        <p class="form-control-plaintext mb-0"><strong>@GetTypeDisplayLabel(editingAccountType)</strong></p>
                    </div>
                    <div class="mb-3">
                        <label for="editAccountName" class="form-label">Nome</label>
                        <InputText @bind-Value="editAccount.Name" class="form-control" id="editAccountName" />
                        <ValidationMessage For="@(() => editAccount.Name)" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="editInitialBalance" class="form-label">Saldo inicial</label>
                        <InputNumber @bind-Value="editAccount.InitialBalance" class="form-control" id="editInitialBalance" disabled />
                        <small class="text-muted">O saldo inicial não pode ser alterado após a criação; apenas transações alteram o saldo atual.</small>
                    </div>
                    <div class="mb-3 form-check">
                        <InputCheckbox @bind-Value="editAccount.IsActive" class="form-check-input" id="editAccountActive" />
                        <label class="form-check-label" for="editAccountActive">Conta ativa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideEditModal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isUpdating">
                        @if (isUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Salvando...</text>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <text>Salvar Alterações</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Modal Excluir -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" tabindex="-1" style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-trash text-danger me-2"></i>
                    Excluir conta
                </h5>
                <button type="button" class="btn-close" @onclick="HideDeleteModal"></button>
            </div>
            <div class="modal-body">
                @if (accountToDelete != null)
                {
                    <p>Tem certeza que deseja excluir a conta <strong>@accountToDelete.Name</strong>?</p>
                    <p class="text-danger small mb-0">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Não é possível excluir uma conta com transações associadas. Esta ação não pode ser desfeita.
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal" disabled="@isDeleting">
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAccount" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <text>Excluindo...</text>
                    }
                    else
                    {
                        <i class="fas fa-trash me-2"></i>
                        <text>Excluir</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Account> accounts = new();
    private CreateAccountRequest newAccount = new();
    private UpdateAccountRequest editAccount = new();
    private string editingAccountId = string.Empty;
    private AccountType editingAccountType;
    private bool isLoading = true;
    private bool isCreating = false;
    private bool isUpdating = false;
    private bool isDeleting = false;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private Account? accountToDelete;
    private string listFilterActive = string.Empty;
    private string alertMessage = string.Empty;
    private string alertType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task OnListFilterChanged()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            bool? activeFilter = null;
            if (listFilterActive == "true")
                activeFilter = true;
            else if (listFilterActive == "false")
                activeFilter = false;

            accounts = await AccountService.GetAccountsAsync(activeFilter);
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao carregar contas: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string FormatMoney(decimal value) =>
        value.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"));

    private static string GetTypeBorderColor(AccountType type) =>
        type switch
        {
            AccountType.ContaCorrente => "#0d6efd",
            AccountType.Poupanca => "#198754",
            AccountType.Carteira => "#fd7e14",
            _ => "#6c757d"
        };

    private static string GetTypeBadgeClass(AccountType type) =>
        type switch
        {
            AccountType.ContaCorrente => "bg-primary",
            AccountType.Poupanca => "bg-success",
            AccountType.Carteira => "text-dark bg-warning",
            _ => "bg-secondary"
        };

    private static string GetTypeDisplayLabel(AccountType type) =>
        type switch
        {
            AccountType.ContaCorrente => "Conta corrente",
            AccountType.Poupanca => "Poupança",
            AccountType.Carteira => "Carteira",
            _ => "—"
        };

    private void ShowCreateModal()
    {
        newAccount = new CreateAccountRequest
        {
            Type = AccountType.ContaCorrente,
            IsActive = true,
            InitialBalance = 0
        };
        showCreateModal = true;
        StateHasChanged();
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
        newAccount = new CreateAccountRequest();
        StateHasChanged();
    }

    private void ShowEditModal(Account account)
    {
        if (account == null)
            return;

        editingAccountId = account.Id;
        editingAccountType = account.Type;
        editAccount = new UpdateAccountRequest
        {
            Name = account.Name ?? string.Empty,
            InitialBalance = account.InitialBalance,
            IsActive = account.IsActive
        };
        showEditModal = true;
        StateHasChanged();
    }

    private void HideEditModal()
    {
        showEditModal = false;
        editingAccountId = string.Empty;
        editingAccountType = default;
        editAccount = new UpdateAccountRequest();
        StateHasChanged();
    }

    private void ShowDeleteModal(Account account)
    {
        accountToDelete = account;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void HideDeleteModal()
    {
        showDeleteModal = false;
        accountToDelete = null;
        StateHasChanged();
    }

    private async Task CreateAccount()
    {
        if (isCreating) return;

        isCreating = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.CreateAccountAsync(newAccount);

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideCreateModal();
                await LoadAccounts();
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao criar conta: {ex.Message}", "error");
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private async Task UpdateAccount()
    {
        if (isUpdating || string.IsNullOrEmpty(editingAccountId)) return;

        isUpdating = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.UpdateAccountAsync(editingAccountId, editAccount);

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideEditModal();
                await LoadAccounts();
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao atualizar conta: {ex.Message}", "error");
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteAccount()
    {
        if (isDeleting || accountToDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            var result = await AccountService.DeleteAccountAsync(accountToDelete.Id);

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideDeleteModal();
                await LoadAccounts();
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao excluir conta: {ex.Message}", "error");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void ShowAlert(string message, string type)
    {
        alertMessage = message;
        alertType = type;
        StateHasChanged();

        _ = Task.Delay(5000).ContinueWith(_ =>
        {
            _ = InvokeAsync(() =>
            {
                ClearAlert();
                StateHasChanged();
            });
        });
    }

    private void ClearAlert()
    {
        alertMessage = string.Empty;
        alertType = string.Empty;
    }
}
