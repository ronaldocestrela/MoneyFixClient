@page "/wallets"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Carteiras - MoneyFix</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fa-solid fa-wallet text-primary me-2"></i>
                    Gerenciar Carteiras
                </h2>
                @* <button class="btn btn-primary" @onclick="ShowCreateModal"> *@
                <button class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>
                    Nova Carteira
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>
                        Suas Categorias
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 col-lg-4 mb-3">
                            @* <div class="card border-left-primary h-100"> *@
                            <div class="card h-100"
                                style="border-left: 0.3rem solid #0d6efd">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="card-title text-primary">Carteira 1</h6>
                                            <small class="text-muted">
                                                R$ 1.500,00
                                            </small>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button" id="dropdownMenuButton-1"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-1">
                                                <li>
                                                    <button class="dropdown-item" type="button"
                                                        @* @onclick="() => ShowEditModal(category)" *@
                                                    >
                                                        <i class="fas fa-edit me-2"></i>Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" type="button" disabled>
                                                        <i class="fas fa-trash me-2"></i>Excluir (em breve)
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100"
                                style="border-left: 0.3rem solid #0d9937">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="card-title text-primary">Carteira 2</h6>
                                            <small class="text-muted">
                                                R$ 2.300,00
                                            </small>
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button" id="dropdownMenuButton-1"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-1">
                                                <li>
                                                    <button class="dropdown-item" type="button"
                                                        @* @onclick="() => ShowEditModal(category)" *@
                                                    >
                                                        <i class="fas fa-edit me-2"></i>Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item text-danger" type="button" disabled>
                                                        <i class="fas fa-trash me-2"></i>Excluir (em breve)
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>