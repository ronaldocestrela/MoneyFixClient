@page "/reset-password"
@using MoneyFixClient.Models
@using MoneyFixClient.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Redefinir senha - MoneyFix</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">
                        <i class="fas fa-lock text-primary me-2"></i>
                        Nova senha
                    </h3>

                    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label" for="rp-email">Email</label>
                            <InputText id="rp-email" class="form-control" @bind-Value="model.Email" type="email" />
                            <ValidationMessage For="@(() => model.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="rp-token">Token</label>
                            <InputTextArea id="rp-token" class="form-control font-monospace small" rows="2" @bind-Value="model.Token" />
                            <ValidationMessage For="@(() => model.Token)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="rp-new">Nova senha</label>
                            <InputText id="rp-new" class="form-control" type="password" @bind-Value="model.NewPassword" />
                            <ValidationMessage For="@(() => model.NewPassword)" />
                            <div class="form-text small">Mínimo 8 caracteres, com maiúscula, minúscula, número e especial.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="rp-confirm">Confirmar nova senha</label>
                            <InputText id="rp-confirm" class="form-control" type="password" @bind-Value="confirmPassword" />
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(infoMessage))
                        {
                            <div class="alert alert-success" role="alert">@infoMessage</div>
                        }
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <span>Redefinir senha</span>
                                }
                            </button>
                            <a href="/login" class="btn btn-link">Voltar ao login</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ResetPasswordRequest model = new();
    private string confirmPassword = string.Empty;
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string infoMessage = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = uri.Query.TrimStart('?');
        foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length != 2) continue;
            var key = Uri.UnescapeDataString(kv[0]);
            var value = Uri.UnescapeDataString(kv[1]);
            if (string.Equals(key, "email", StringComparison.OrdinalIgnoreCase))
                model.Email = value;
            else if (string.Equals(key, "token", StringComparison.OrdinalIgnoreCase))
                model.Token = value;
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        infoMessage = string.Empty;

        if (!string.Equals(model.NewPassword, confirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "As senhas não conferem.";
            return;
        }

        isLoading = true;
        try
        {
            var (ok, message) = await AuthService.ResetPasswordAsync(model);
            if (ok)
            {
                infoMessage = "Senha alterada. Redirecionando para o login...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(message) ? "Não foi possível redefinir a senha." : message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
