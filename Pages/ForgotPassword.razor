@page "/forgot-password"
@using MoneyFixClient.Models
@using MoneyFixClient.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Esqueci a senha - MoneyFix</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">
                        <i class="fas fa-key text-primary me-2"></i>
                        Recuperar senha
                    </h3>
                    <p class="text-muted small">
                        Informe seu email. Se existir uma conta ativa, um token de redefinição será gerado (MVP: exibido abaixo).
                    </p>

                    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label" for="fp-email">Email</label>
                            <InputText id="fp-email" class="form-control" @bind-Value="model.Email" type="email" placeholder="seu@email.com" />
                            <ValidationMessage For="@(() => model.Email)" />
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success" role="alert">@successMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(resetToken))
                        {
                            <div class="mb-3">
                                <label class="form-label">Token de redefinição</label>
                                <textarea class="form-control font-monospace small" rows="3" readonly>@resetToken</textarea>
                                <div class="mt-2">
                                    <a class="btn btn-outline-primary btn-sm" href="@($"/reset-password?email={Uri.EscapeDataString(model.Email)}&token={Uri.EscapeDataString(resetToken)}")">
                                        Ir para redefinir senha
                                    </a>
                                </div>
                            </div>
                        }
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Enviando...</span>
                                }
                                else
                                {
                                    <span>Enviar</span>
                                }
                            </button>
                            <a href="/login" class="btn btn-link">Voltar ao login</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordRequest model = new();
    private bool isLoading;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string resetToken = string.Empty;

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        resetToken = string.Empty;
        isLoading = true;
        try
        {
            var (success, data, err) = await AuthService.ForgotPasswordAsync(model.Email);
            if (success && data != null)
            {
                successMessage = string.IsNullOrWhiteSpace(data.Message)
                    ? "Solicitação processada."
                    : data.Message;
                resetToken = data.ResetToken ?? string.Empty;
            }
            else
            {
                errorMessage = string.IsNullOrWhiteSpace(err) ? "Não foi possível processar o pedido." : err;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
