@page "/transactions"
@using MoneyFixClient.Models
@using MoneyFixClient.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject AccountService AccountService
@attribute [Authorize]

<PageTitle>Transações - MoneyFix</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-exchange-alt text-primary me-2"></i>
                    Gerenciar Transações
                </h2>
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>
                    Nova Transação
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert @(alertType == "success" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    <i class="fas @(alertType == "success" ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                    @alertMessage
                    <button type="button" class="btn-close" @onclick="ClearAlert"></button>
                </div>
            </div>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header py-2">
                    <h6 class="mb-0"><i class="fas fa-filter me-2"></i>Filtros</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label small mb-0">De</label>
                            <InputDate TValue="DateTime?" @bind-Value="filterFrom" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Até</label>
                            <InputDate TValue="DateTime?" @bind-Value="filterTo" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Tipo</label>
                            <select class="form-select" @bind="filterType">
                                <option value="">Todos</option>
                                <option value="Entrada">Entrada</option>
                                <option value="Saida">Saída</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Categoria</label>
                            <select class="form-select" @bind="filterCategoryId">
                                <option value="">Todas</option>
                                @foreach (var c in categories.OrderBy(x => x.Name))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">Conta</label>
                            <select class="form-select" @bind="filterAccountId">
                                <option value="">Todas</option>
                                @foreach (var a in accounts.OrderBy(x => x.Name))
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="ApplyFiltersAsync" disabled="@isLoading">
                                <i class="fas fa-search me-1"></i>Aplicar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>
                        Suas Transações
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <label class="me-2">Itens por página:</label>
                            <select class="form-select d-inline-block w-auto me-3" value="@pageSize" @onchange="OnPageSizeChanged">
                                @foreach (var opt in pageSizeOptions)
                                {
                                    <option value="@opt">@opt</option>
                                }
                            </select>
                            <span class="text-muted">Total: @totalItems</span>
                        </div>
                        <div>
                            <small class="text-muted">Página @currentPage de @totalPages</small>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Carregando...</span>
                            </div>
                            <p class="mt-2">Carregando transações...</p>
                        </div>
                    }
                    else if (transactions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Descrição</th>
                                        <th>Valor</th>
                                        <th>Data</th>
                                        <th>Tipo</th>
                                        <th>Conta</th>
                                        <th>Categoria</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in transactions)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@(string.IsNullOrWhiteSpace(transaction.Description) ? "—" : transaction.Description)</strong>
                                                <br>
                                                <small class="text-muted">ID: @(transaction.Id.Length > 8 ? transaction.Id[..8] + "..." : transaction.Id)</small>
                                            </td>
                                            <td>
                                                <span class="@(transaction.IsExpense ? "text-danger" : "text-success")">
                                                    @(transaction.IsExpense ? "-" : "+")@transaction.Amount.ToString("C")
                                                </span>
                                            </td>
                                            <td>@transaction.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(transaction.IsExpense ? "bg-danger" : "bg-success")">
                                                    @(transaction.IsExpense ? "Saída" : "Entrada")
                                                </span>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(transaction.AccountName) ? "—" : transaction.AccountName)</td>
                                            <td>@transaction.CategoryName</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(transaction)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteConfirmation(transaction)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (totalPages > 1)
                            {
                                <nav>
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Anterior</button>
                                        </li>
                                        @for (int i = 1; i <= totalPages; i++)
                                        {
                                            <li class="page-item @(currentPage == i ? "active" : "")">
                                                <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                                            </li>
                                        }
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Próximo</button>
                                        </li>
                                    </ul>
                                </nav>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma transação encontrada</h5>
                            <p class="text-muted">Crie sua primeira transação ou ajuste os filtros.</p>
                            <button class="btn btn-primary" @onclick="ShowCreateModal">
                                <i class="fas fa-plus me-2"></i>
                                Criar Primeira Transação
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Criar/Editar Transação -->
<div class="modal fade @(showTransactionModal ? "show d-block" : "")" tabindex="-1" style="@(showTransactionModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas @(editingTransaction != null ? "fa-edit" : "fa-plus") text-primary me-2"></i>
                    @(editingTransaction != null ? "Editar Transação" : "Nova Transação")
                </h5>
                <button type="button" class="btn-close" @onclick="HideTransactionModal"></button>
            </div>
            <EditForm Model="@transactionForm" OnValidSubmit="@SaveTransaction">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="account" class="form-label">Conta</label>
                            <InputSelect @bind-Value="transactionForm.AccountId" class="form-select" id="account">
                                <option value="">Selecione uma conta</option>
                                @foreach (var a in accounts.OrderBy(x => x.Name))
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => transactionForm.AccountId)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="category" class="form-label">Categoria</label>
                            <InputSelect @bind-Value="transactionForm.CategoryId" class="form-select" id="category">
                                <option value="">Selecione uma categoria</option>
                                <optgroup label="Entrada">
                                    @foreach (var category in categories.Where(c => c.Type == CategoryType.Entrada).OrderBy(c => c.Name))
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </optgroup>
                                <optgroup label="Saída">
                                    @foreach (var category in categories.Where(c => c.Type == CategoryType.Saida).OrderBy(c => c.Name))
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </optgroup>
                            </InputSelect>
                            <ValidationMessage For="@(() => transactionForm.CategoryId)" class="text-danger" />
                            <small class="text-muted">O tipo da transação (Entrada/Saída) vem da categoria.</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="description" class="form-label">Descrição <span class="text-muted">(opcional)</span></label>
                            <InputText @bind-Value="descriptionBind" class="form-control" id="description" maxlength="500"
                                       placeholder="Ex.: Almoço, Salário, Gasolina..." />
                            <ValidationMessage For="@(() => transactionForm.Description)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="amount" class="form-label">Valor</label>
                            <InputNumber @bind-Value="transactionForm.Amount" class="form-control" id="amount" step="0.01" placeholder="0,00" />
                            <ValidationMessage For="@(() => transactionForm.Amount)" class="text-danger" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="date" class="form-label">Data e hora</label>
                            <input type="datetime-local" class="form-control" id="date" @bind="transactionForm.OccurredAt" @bind:event="oninput" />
                            <ValidationMessage For="@(() => transactionForm.OccurredAt)" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideTransactionModal">
                        <i class="fas fa-times me-2"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Salvando...</text>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <text>@(editingTransaction != null ? "Atualizar" : "Criar") Transação</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade @(showDeleteModal ? "show d-block" : "")" tabindex="-1" style="@(showDeleteModal ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-trash text-danger me-2"></i>
                    Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close" @onclick="HideDeleteModal"></button>
            </div>
            <div class="modal-body">
                @if (transactionToDelete != null)
                {
                    <p>Tem certeza que deseja excluir a transação:</p>
                    <div class="alert alert-warning">
                        <strong>@(string.IsNullOrWhiteSpace(transactionToDelete.Description) ? "(sem descrição)" : transactionToDelete.Description)</strong><br>
                        Valor: <strong>@transactionToDelete.Amount.ToString("C")</strong><br>
                        Data: <strong>@transactionToDelete.OccurredAt.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <p class="text-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Esta ação não pode ser desfeita.
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal">
                    <i class="fas fa-times me-2"></i>
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <text>Excluindo...</text>
                    }
                    else
                    {
                        <i class="fas fa-trash me-2"></i>
                        <text>Excluir</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Transaction> allTransactions = new();
    private List<Transaction> transactions = new();
    private List<Category> categories = new();
    private List<Account> accounts = new();
    private TransactionRequest transactionForm = new();
    private Transaction? editingTransaction = null;
    private Transaction? transactionToDelete = null;

    private DateTime? filterFrom;
    private DateTime? filterTo;
    private string filterType = "";
    private string filterCategoryId = "";
    private string filterAccountId = "";

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalItems = 0;
    private int[] pageSizeOptions = new[] { 5, 10, 20, 50 };

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool showTransactionModal = false;
    private bool showDeleteModal = false;

    private string alertMessage = string.Empty;
    private string alertType = string.Empty;

    /// <summary>
    /// Liga descrição opcional ao formulário (string vazia vira null para a API).
    /// </summary>
    private string descriptionBind
    {
        get => transactionForm.Description ?? string.Empty;
        set => transactionForm.Description = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 1;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var filter = new TransactionFilter
            {
                From = filterFrom,
                To = filterTo,
                Type = string.IsNullOrWhiteSpace(filterType) ? null : filterType,
                CategoryId = string.IsNullOrWhiteSpace(filterCategoryId) ? null : filterCategoryId,
                AccountId = string.IsNullOrWhiteSpace(filterAccountId) ? null : filterAccountId
            };

            var transactionsTask = TransactionService.GetTransactionsAsync(filter);
            var categoriesTask = CategoryService.GetCategoriesAsync();
            var accountsTask = AccountService.GetAccountsAsync();

            await Task.WhenAll(transactionsTask, categoriesTask, accountsTask);

            allTransactions = await transactionsTask;
            categories = await categoriesTask;
            accounts = await accountsTask;

            ApplyClientPaging();
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao carregar dados: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyClientPaging()
    {
        var ordered = allTransactions.OrderByDescending(t => t.OccurredAt).ToList();
        totalItems = ordered.Count;
        totalPages = Math.Max(1, (int)Math.Ceiling(totalItems / (double)pageSize));
        if (currentPage > totalPages)
            currentPage = totalPages;
        if (currentPage < 1)
            currentPage = 1;

        transactions = ordered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void ShowCreateModal()
    {
        editingTransaction = null;
        transactionForm = new TransactionRequest
        {
            OccurredAt = DateTime.Now,
            AccountId = accounts.FirstOrDefault()?.Id ?? string.Empty
        };
        showTransactionModal = true;
        StateHasChanged();
    }

    private void ShowEditModal(Transaction transaction)
    {
        editingTransaction = transaction;
        transactionForm = new TransactionRequest
        {
            AccountId = transaction.AccountId,
            CategoryId = transaction.CategoryId,
            Amount = transaction.Amount,
            OccurredAt = transaction.OccurredAt,
            Description = string.IsNullOrWhiteSpace(transaction.Description) ? null : transaction.Description
        };
        showTransactionModal = true;
        StateHasChanged();
    }

    private void HideTransactionModal()
    {
        showTransactionModal = false;
        editingTransaction = null;
        transactionForm = new TransactionRequest();
        StateHasChanged();
    }

    private async Task SaveTransaction()
    {
        if (isSaving) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            TransactionResponse result;

            if (editingTransaction != null)
            {
                result = await TransactionService.UpdateTransactionAsync(editingTransaction.Id, transactionForm);
            }
            else
            {
                result = await TransactionService.CreateTransactionAsync(transactionForm);
            }

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideTransactionModal();
                await LoadData();
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao salvar transação: {ex.Message}", "error");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirmation(Transaction transaction)
    {
        transactionToDelete = transaction;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void HideDeleteModal()
    {
        showDeleteModal = false;
        transactionToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (isDeleting || transactionToDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            var result = await TransactionService.DeleteTransactionAsync(transactionToDelete.Id);

            if (result.Success)
            {
                ShowAlert(result.Message, "success");
                HideDeleteModal();
                await LoadData();

                if (!transactions.Any() && totalPages > 0 && currentPage > totalPages)
                {
                    currentPage = totalPages;
                    ApplyClientPaging();
                    StateHasChanged();
                }
            }
            else
            {
                ShowAlert(result.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Erro ao excluir transação: {ex.Message}", "error");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void ShowAlert(string message, string type)
    {
        alertMessage = message;
        alertType = type;
        StateHasChanged();

        Task.Delay(5000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                ClearAlert();
                StateHasChanged();
            });
        });
    }

    private void ClearAlert()
    {
        alertMessage = string.Empty;
        alertType = string.Empty;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        if (page == currentPage) return;

        currentPage = page;
        ApplyClientPaging();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (e?.Value != null && int.TryParse(e.Value.ToString(), out var newSize))
        {
            pageSize = newSize;
        }

        currentPage = 1;
        ApplyClientPaging();
        StateHasChanged();
        await Task.CompletedTask;
    }
}
